# Copy this file to `.env` and adjust values if needed.
# Never commit real secrets — this project ships with safe defaults.

# SQLite database file (relative to backend/). Use postgresql://... for production.
DATABASE_URL=sqlite:///./seedsathi.db

# Frontend dev-server origin allowed by CORS
FRONTEND_ORIGIN=http://localhost:5173

# Frontend: base URL of this API (used by the React app via VITE_API_URL)
VITE_API_URL=http://localhost:8000
